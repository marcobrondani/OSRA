{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "category-table.schema.json",
  "title": "OSRA category rule table",
  "description": "Expected category, Concentration flag and clocks for combinations of the three conditions and the single point flag (TR-101).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "cites", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "category-table"},
    "cites": {"type": "string"},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["condition_1", "condition_2", "condition_3", "single_point", "category", "concentration_flag", "clocks"],
        "properties": {
          "condition_1": {"type": "boolean"},
          "condition_2": {"type": "boolean"},
          "condition_3": {"type": "boolean"},
          "single_point": {"type": "boolean"},
          "category": {"$ref": "results.schema.json#/$defs/category"},
          "concentration_flag": {"type": "boolean"},
          "clocks": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/duration"}}
        }
      }
    }
  }
}
