{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mapping.schema.json",
  "title": "OSRA regulatory mapping",
  "description": "The clauses of one regulatory instrument that OSRA cites, each checked against the primary text, with the date of the check and the actions and integration points that cite it (FR-64, TR-16, TR-16a).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "regime", "version", "verified", "sources", "clauses"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "mapping"},
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "regime": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "verified": {"$ref": "common.schema.json#/$defs/date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "instrument", "url", "text"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "instrument": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://eur-lex\\.europa\\.eu/"},
          "text": {"type": "string", "minLength": 1}
        }
      }
    },
    "clauses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "reference", "title", "verified"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+\\.[a-z0-9.-]+$"},
          "source": {"type": "string"},
          "reference": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "verified": {"$ref": "common.schema.json#/$defs/date"},
          "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[DVRG][0-9]+$"}},
          "integration": {"type": "string"},
          "note": {"type": "string"}
        }
      }
    }
  }
}
